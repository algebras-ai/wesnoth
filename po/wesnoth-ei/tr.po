#. Button label for 'take an item'
#: data/campaigns/Eastern_Invasion/utils/items.cfg:40
#: data/campaigns/Eastern_Invasion/utils/items.cfg:1109
#: data/campaigns/Eastern_Invasion/utils/items.cfg:1265
#| msgid "Take it."
msgid "Take"
msgstr "Almak"

#. [item_dialog]: description={ITEM_DESC}
