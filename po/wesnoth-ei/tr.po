#~ msgid ""
#~ "Noo!! He will reach Mal-Ravanal’s capital, and I shall be punished for "
#~ "letting him escape!"
#~ msgstr ""
#~ "Hayır!! Mal-Ravanal'ın başkentine ulaşacak ve kaçmasına izin verdiğim için "
#~ "cezalandırılacağım!"

#~ msgid "Mal-Galkar"
#~ msgstr "Mal-Galkar"

