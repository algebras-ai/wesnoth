msgstr "Deniz Halkı"

#. [leader]: id=Nemas, type=Merman Warrior
#: data/campaigns/Winds_of_Fate/scenarios/04_Journey.cfg:77
msgid "Nemas"
msgstr "Nemas"

#. [side]
#: data/campaigns/Winds_of_Fate/scenarios/04_Journey.cfg:94
msgid "Serpents"
msgstr "Yılanlar"

