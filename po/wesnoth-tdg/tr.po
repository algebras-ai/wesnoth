msgstr "<i>Hilekar</i>'daki her iki düşman liderini Garard'dan önce yenin."

#. [achievement_group]
#: data/campaigns/The_Deceivers_Gambit/achievements.cfg:26
msgid "Scenario 5: Hook, Line, and Sinker"
msgstr "Senaryo 5: Olta, Misina ve Kurşun"

#. [achievement_group]
#: data/campaigns/The_Deceivers_Gambit/achievements.cfg:27
msgid "Complete <i>Ring of Swords</i> with Garard at full hp."
msgstr "<i>Kılıç Halkası</i>'nı Garard tam canla tamamlayın."

#. [achievement_group]
#: data/campaigns/The_Deceivers_Gambit/achievements.cfg:27
