#~ msgid "Fools! That lich will be the death of us all! Now we are all doomed!"
#~ msgstr "Aptallar! O hortlak hepimizin sonu olacak! Şimdi hepimiz mahvolduk!"

#~ msgid "Beast of the Lake"
#~ msgstr "Göl Canavarı"

#~ msgid "Graar!"
#~ msgstr "Graar!"

