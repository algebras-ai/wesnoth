#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:667
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:47
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:62
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:81
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:99
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:114
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:44
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:66
#: data/campaigns/Heir_To_The_Throne/scenarios/06_The_Isle_of_Alduin.cfg:38
#: data/campaigns/Heir_To_The_Throne/scenarios/10_Elensefar_Before.cfg:46
#: data/campaigns/Heir_To_The_Throne/scenarios/10_Elensefar_Before.cfg:116
#: data/campaigns/Heir_To_The_Throne/scenarios/13_Fort_Tahn.cfg:65
#: data/campaigns/Heir_To_The_Throne/scenarios/17_Crossroads.cfg:65
#: data/campaigns/Heir_To_The_Throne/scenarios/18_The_Highwaymen.cfg:44
#: data/campaigns/Heir_To_The_Throne/scenarios/18_The_Highwaymen.cfg:58
#: data/campaigns/Heir_To_The_Throne/scenarios/18_The_Highwaymen.cfg:78
#: data/campaigns/Heir_To_The_Throne/scenarios/48_Dan_Tonk.cfg:38
#: data/campaigns/Heir_To_The_Throne/scenarios/48_Dan_Tonk.cfg:62
#: data/campaigns/Heir_To_The_Throne/scenarios/48_Dan_Tonk.cfg:82
msgid "Army of Wesnoth"
msgstr "Wesnoth Ordusu"

#. [side]
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:757
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:778
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:139
msgid "Aethenwood Elves"
msgstr "Aethenwood Elfleri"

#. [message]: speaker=Konrad {KONRAD_VARIATION concerned}
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1138
msgid ""
"I’m here, Delfador! I thought you were calling me for more training, but "
"there’s smoke rising from the forest. What’s going on?"
msgstr ""
"Buradayım, Delfador! Beni daha fazla antrenman için çağırdığını sanmıştım "
"ama ormandan duman yükseliyor. Neler oluyor?"

#. [message]: speaker=Ethiliel
#. human armies have surrounded the Aethenwood and are burning it
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1144
msgid ""
"Trouble from your Queen Asheviere, child! She knows that we sheltered you "
"throughout your youth. Now she comes bearing fiery retribution, and the dawn"
" of a dark age for the Aethenwood."
msgstr ""
"Kraliçen Aşivye'den başın dertte, çocuk! Gençliğin boyunca sana sığınak "
"olduğumuzu biliyor. Şimdi ateşli bir intikam ve Aethenwood için karanlık bir"
" çağın şafağını getiriyor."

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1148
msgid ""
"I have already been injured. I fear she is after you personally, Master "
"Konrad!"
msgstr "Zaten yaralandım. Korkarım şahsen senin peşinde, Üstat Konrad!"

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1152
msgid ""
"They have us nearly surrounded, but we can still flee to the west. I will "
"protect you!"
msgstr ""
"Bizi neredeyse kuşattılar ama hala batıya kaçabiliriz. Seni koruyacağım!"

#. [message]: speaker=Konrad {KONRAD_VARIATION concerned}
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1156
msgid "But what about the elves? They are our friends! We have to help fight!"
msgstr "Peki ya elfler? Onlar bizim dostlarımız! Savaşmaya yardım etmeliyiz!"

#. [message]: speaker=Galdrad
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1160
msgid ""
"Asheviere is all of our enemy. We will fight the invaders, but you must "
"escape, Konrad. Lord Kalenz has commanded your safety. It is imperative that"
" you escape!"
msgstr ""
"Aşivye hepimizin düşmanı. İşgalcilerle savaşacağız ama sen kaçmalısın, "
"Konrad. Lord Kalenz senin güvenliğini emretti. Kaçman şart!"

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1164
msgid ""
"Galdrad is right. Do not throw your life away so easily, Your Highness."
msgstr ""
"Galdrad haklı. Hayatınızı bu kadar kolay harcamayın, Yüce Majesteleri."

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1168
msgid "There can be no looking back. We must go quickly!"
msgstr "Geriye bakmak yok. Hızlı gitmeliyiz!"

#. [objective]: condition=win
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1180
msgid "Move Konrad and Delfador to the west edge of the map"
msgstr "Konrad ve Delfador'u haritanın batı kenarına taşı"

#. [message]: speaker=Konrad
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1214
msgid "Watch out for the fire!"
msgstr "Ateşe dikkat et!"

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1225
msgid ""
"Konrad, it took you some time to rise this morning. I’m not angry, but I am "
"worried. I won’t always be here to keep you safe!"
msgstr ""
"Konrad, bu sabah kalkman biraz zaman aldı. Kızgın değilim ama endişeliyim. "
"Seni her zaman güvende tutmak için burada olamayacağım!"

#. [message]: speaker=Konrad
#. Asheviere and her army are burning the Aethenwood and killing Konrad's
#. elven friends.
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1230
msgid ""
"I know, Delfador, and I’m sorry. This is horrible! How did the fires get so "
"close without me noticing!?"
msgstr ""
"Biliyorum, Delfador, ve üzgünüm. Bu korkunç! Yangınlar ben fark etmeden "
"nasıl bu kadar yaklaştı!?"

#. [message]: speaker=Konrad
#. Asheviere and her army are burning the Aethenwood and killing Konrad's
#. elven friends.
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1235
msgid ""
"I’ve never seen so many humans all in one place before. I can’t believe you "
"and I are really the same as them..."
msgstr ""
"Daha önce hiç bu kadar çok insanı bir arada görmemiştim. Seninle benim "
"gerçekten onlarla aynı olduğumuza inanamıyorum..."

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1239
msgid ""
"<i><b>I’m</b></i> sorry you couldn’t have grown up among your own people. "
"Our kind can be a little crude, but we aren’t usually so bad — it’s "
"Asheviere who’s stirred up all this mischief."
msgstr ""
"Kendi halkının arasında büyüyemediğin için <i><b>üzgünüm</b></i>. Bizim "
"türümüz biraz kaba olabilir ama genellikle o kadar kötü değiliz — tüm bu "
"yaramazlığı karıştıran Aşivye."

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1243
msgid ""
"And if my suspicions are true, this is merely a small part of the greater "
"whole of her armies! We must get out of this forest so we can see what else "
"is going on."
msgstr ""
"Ve eğer şüphelerim doğruysa, bu onun ordularının daha büyük bütününün sadece"
" küçük bir parçası! Neler olup bittiğini görmek için bu ormandan çıkmalıyız."

#. [message]: type=Cavalryman # their armored helm looks more intimidating
#. than our Bowman or Spearman portraits
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1255
msgid "Surround the enclaves! Don’t let anyone escape!"
msgstr "Anklavları kuşatın! Kimsenin kaçmasına izin vermeyin!"

#. [message]: speaker=Galdrad
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1274
msgid "I am Galdrad. You will have to fight me to get any further!"
msgstr ""
"Ben Galdrad'ım. Daha ileri gitmek için benimle savaşmak zorunda kalacaksın!"

#. [message]: speaker=Konrad {KONRAD_VARIATION mad}
#. said when Konrad attacks / is attacked
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1295
msgid "Leave my home alone, you villain!"
msgstr "Evimi rahat bırak, seni alçak!"

#. [message]
#. Asheviere's official stance is that Konrad is a fraud. At this point, the
#. player believes Konrad is the true prince
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1300
msgid ""
"You’re just an imposter! Everyone knows the real Prince Konrad died long "
"ago."
msgstr ""
"Sen sadece bir sahtekarsın! Herkes gerçek Prens Konrad'ın çok uzun zaman "
"önce öldüğünü biliyor."

#. [message]: speaker=second_unit
#. said when Delfador attacks. The unit flees off the map before Delfador can
#. deal damage
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1313
msgid "Oh no, it’s HIM, it’s Delfador THE GREAT! Get me out of here!"
msgstr "Eyvah, O, o BÜYÜK Delfador! Beni buradan çıkarın!"

#. [message]: speaker=Delfador
#. an enemy has just fled, even before Delfador got a chance to attack
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1335
msgid "My reputation precedes me."
msgstr "Şöhretim benden önce gelir."

#. [message]: speaker=Delfador
#. Delfador has killed 10 enemies, and the player has earned an achievement
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1362
msgid "Only fools dare oppose me."
msgstr "Sadece aptallar bana karşı gelmeye cüret eder."

#. [message]: speaker=narrator
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1376
msgid ""
"Wow, you’ve defeated all the invaders and saved the Aethenwood! I didn’t "
"expect this to be possible, so if you’re reading this message in-game you’ve"
" exceeded all expectations! (or you’re cheating to see what happens / using "
"overpowered add-ons)"
msgstr ""
"Vay canına, tüm işgalcileri yendin ve Aethenwood'u kurtardın! Bunun mümkün "
"olmasını beklemiyordum, bu yüzden bu mesajı oyun içinde okuyorsan tüm "
"beklentileri aştın! (ya da ne olduğunu görmek için hile yapıyorsun / aşırı "
"güçlü eklentiler kullanıyorsun)"

#. [message]: speaker=narrator
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1381
msgid ""
"Unfortunately this breaks the story, so for the rest of the campaign we’re "
"going to have to pretend that this never happened, okay?"
msgstr ""
"Maalesef bu hikayeyi bozuyor, bu yüzden kampanyanın geri kalanında bunun hiç"
" yaşanmadığını varsaymak zorunda kalacağız, tamam mı?"

#. [message]: speaker=Isolde
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1394
msgid "Impossible! I must report back to the queen."
msgstr "İmkansız! Kraliçeye geri rapor vermem gerek."

#. [message]: speaker=Konrad
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1417
msgid "Hurry, Delfador! I’m not leaving without you."
msgstr "Acele et, Delfador! Sensiz gitmiyorum."

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1431
msgid "Hurry along, Konrad! We leave together, or not at all."
msgstr "Acele et, Konrad! Ya birlikte gideriz ya da hiç gitmeyiz."

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1457
msgid "Time to go, Konrad! Come on!"
msgstr "Gitme zamanı, Konrad! Hadi!"

#. [message]: speaker=Konrad {KONRAD_VARIATION concerned}
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1461
msgid ""
"Of course you are right, Delfador. But what will become of our friends here?"
msgstr "Elbette haklısın, Delfador. Ama buradaki dostlarımıza ne olacak?"

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1465
msgid ""
"The elves will fight. They may even prevail. But I fear things do not bode "
"well for them. Let us not speak of it now. Onward!"
msgstr ""
"Elfler savaşacak. Hatta galip gelebilirler. Ama korkarım işler onlar için "
"iyi gitmiyor. Şimdi bundan bahsetmeyelim. İleri!"

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1481
msgid "Hurry, hurry! We have but a moment left."
msgstr "Acele et, acele et! Sadece bir anımız kaldı."

#. [message]: role=halberdier
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1492
msgid ""
"General, we’ve seized the western forest and occupied the elf-roads! The "
"rest of the men will be here shortly."
msgstr ""
"General, batı ormanını ele geçirdik ve elf yollarını işgal ettik! Adamların "
"geri kalanı kısa süre içinde burada olacak."

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:1496
msgid "We have run out of time! There can be no more escape..."
msgstr "Zamanımız tükendi! Artık kaçış yok..."

#. [scenario]
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:19
msgid "Flight of the Elves"
msgstr "Elflerin Uçuşu"

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:187
msgid "Quillan"
msgstr "Quillan"

#. [unit]: id=Tanyth, type=Elvish Avenger, gender=female
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:205
msgid "Tanyth"
msgstr "Tanyth"

#. [message]: speaker=Quillan
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:246
msgid ""
"Master Konrad, I am pleased to see that you have escaped! And even more "
"pleased to see that you have returned."
msgstr ""
"Usta Konrad, kaçtığınızı gördüğüme sevindim! Ve geri döndüğünüzü gördüğüme "
"daha da sevindim."

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:251
msgid ""
"What is the matter, Quillan? We had planned for you to all go into hiding "
"after Konrad and I fled, if you could not defeat the attackers. Yet the "
"fighting continues."
msgstr ""
"Sorun ne, Quillan? Konrad ve ben kaçtıktan sonra, saldırganları yenemezseniz"
" hepinizin saklanmasını planlamıştık. Ama çatışma devam ediyor."

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:253
msgid ""
"I suspect Elensefar to be under siege as well — I cannot leave Maddock to "
"fight alone, yet neither can I leave you elves to be slaughtered."
msgstr ""
"Elensefar'ın da kuşatma altında olduğundan şüpheleniyorum — Maddock'u tek "
"başına savaşmaya bırakamam, ama sizi elfleri de katledilmeye bırakamam."

#. [message]: speaker=Konrad {KONRAD_VARIATION concerned}
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:258
msgid ""
"Quillan, what’s going on? You were all to have gone into hiding after I "
"fled, if you could not defeat the attackers, but I still see fires and "
"fighting in the distance!"
msgstr ""
"Quillan, neler oluyor? Ben kaçtıktan sonra, saldırganları yenemezseniz "
"hepinizin saklanması gerekiyordu, ama uzakta hala yangınlar ve çatışmalar "
"görüyorum!"

#. [message]: speaker=Quillan
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:263
msgid ""
"Our lines have been broken; men pour into the Aethenwood. The marshals are "
"coordinating a retreat, but are being harried at every step."
msgstr ""
"Hatlarımız yarıldı; adamlar Aethenwood'a akın ediyor. Mareşaller bir geri "
"çekilmeyi koordine ediyor, ancak her adımda taciz ediliyorlar."

#. [message]: speaker=leader4
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:267
msgid "Don’t let them get away! The queen demands a total victory!"
msgstr "Kaçmalarına izin vermeyin! Kraliçe mutlak bir zafer istiyor!"

#. [message]: speaker=leader3
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:271
msgid ""
"Kill any who resist, but take the rest alive. We need prisoners for "
"interrogation and slaves for the mines!"
msgstr ""
"Direnenleri öldürün, ama geri kalanları canlı yakalayın. Sorgulama için "
"mahkumlara ve madenler için kölelere ihtiyacımız var!"

#. [message]: speaker=Quillan
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:277
msgid ""
"My riders and I are the first to break free of our encirclement! We are "
"swift enough to escape the spears, but our slower brethren may be caught as "
"they retreat."
msgstr ""
"Süvarilerim ve ben kuşatmamızdan kurtulan ilk kişileriz! Mızraklardan "
"kaçacak kadar hızlıyız, ancak daha yavaş kardeşlerimiz geri çekilirken "
"yakalanabilir."

#. [message]: speaker=Quillan
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:281
msgid ""
"They will be here soon. Konrad, you must help us all reach safety across the"
" river!"
msgstr ""
"Yakında burada olacaklar. Konrad, hepimizin nehrin karşısına güvenli bir "
"şekilde geçmesine yardım etmelisin!"

#. [objective]: condition=win
#. $dead_elves is a number; probably between 0 and 20
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:292
msgid "Survive until all elves escape or die ($dead_elves dead so far)"
msgstr ""
"Tüm elfler kaçana veya ölene kadar hayatta kalın (şu ana kadar $dead_elves "
"ölü)"

#. [objective]: condition=win
#. [objective]: condition=win, description=<span strikethrough='true'
#. color='#A9A9A9'>
#. if 15 or fewer elves die, Konrad will learn to recruit Elvish Archers
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:298
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:305
msgid "15 or fewer deaths: recruit Elvish Archers"
msgstr "15 veya daha az ölüm: Elf Okçuları topla"

#. [objective]: condition=win
#. [objective]: condition=win, description=<span strikethrough='true'
#. color='#A9A9A9'>
#. if 10 or fewer elves die, Konrad will learn to recruit Elvish Scouts
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:314
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:321
msgid "10 or fewer deaths: recruit Elvish Scouts"
msgstr "10 veya daha az ölüm: Elf İzcileri topla"

#. [objective]: condition=win, description=
#. [objective]: condition=win, description=<span strikethrough='true'
#. color='#A9A9A9'>
#. if 5 or fewer elves die, Konrad will learn to recruit Elvish Fighters
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:331
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:338
msgid "5 or fewer deaths: recruit Elvish Fighters"
msgstr "5 veya daha az ölüm: Elf Savaşçıları topla"

#. [message]: speaker=Konrad
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:375
msgid ""
"The elves are going south across the river, but we must stand our ground and"
" help them escape!"
msgstr ""
"Elfler nehrin güneyine doğru gidiyor, ama biz yerimizde durup onların "
"kaçmasına yardım etmeliyiz!"

#. [message]: speaker=unit
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:398
msgid "I have reached the southern shore! Scatter into the deep forest!"
msgstr "Güney kıyıya ulaştım! Derin ormana dağılın!"

#. [message]: speaker=Konrad {KONRAD_VARIATION concerned}
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:412
msgid ""
"Will none of you stay and help fight? If we all stand together, surely we "
"can resist the invaders!"
msgstr ""
"Hiçbiriniz kalıp savaşmaya yardım etmeyecek misiniz? Hepimiz birlikte "
"durursak, işgalcilere kesinlikle direnebiliriz!"

#. [message]: speaker=unit
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:416
msgid ""
"To stand together is to fall together, Konrad. We defended our homes in the "
"east as best we could, but now the decision has been made to scatter, not to"
" fight."
msgstr ""
"Birlikte durmak, birlikte düşmektir, Konrad. Doğudaki evlerimizi elimizden "
"geldiğince savunduk, ama şimdi savaşmak yerine dağılma kararı alındı."

#. [message]: speaker=unit
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:420
msgid ""
"The Aethenwood is but a backwater compared to Wesmere or the Lintanir; the "
"might of Wesnoth is beyond our capacity to withstand. We must scatter and "
"hide if we wish any hope of evading your kin."
msgstr ""
"Aethenwood, Wesmere veya Lintanir'e kıyasla sadece bir taşradır; Wesnoth'un "
"gücü bizim dayanma kapasitemizin ötesindedir. Akrabalarınızdan kaçma "
"umudumuz varsa dağılıp saklanmalıyız."

#. [message]: role=speaker {FILTER_LOCATION x,y,radius=44,7,4}
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:444
msgid ""
"Be swift, friends. We must cross the river and vanish into the southern "
"woods before our pursuers catch us!"
msgstr ""
"Hızlı olun, dostlar. Takipçilerimiz bizi yakalamadan önce nehri geçip güney "
"ormanlarına karışmalıyız!"

#. [message]: speaker=leader3
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:465
msgid "Where are my fencers? They should have started their attack by now."
msgstr ""
"Kılıç ustalarım nerede? Şimdiye kadar saldırılarına başlamış olmaları "
"gerekiyordu."

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:470
msgid "Aramis"
msgstr "Aramis"

#. [message]: speaker=leader6
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:477
msgid ""
"Sorry for the delay, Lieutenant! We’re finally in position, and ready to "
"help intercept the elves."
msgstr ""
"Gecikme için üzgünüm, Teğmen! Sonunda pozisyondayız ve elfleri durdurmaya "
"yardım etmeye hazırız."

#. [message]: speaker=Konrad
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:513
msgid ""
"How many more elves are left to evacuate from the east-halls? We cannot keep"
" fighting forever!"
msgstr ""
"Doğu salonlarından tahliye edilecek kaç elf kaldı? Sonsuza kadar "
"savaşamayız!"

#. [message]: role=speaker {FILTER_LOCATION x,y,radius=44,7,4}
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:518
msgid ""
"Not many. Galdrad is managing the rest of the retreat — you will see him "
"soon!"
msgstr ""
"Çok değil. Galdrad geri çekilmenin geri kalanını yönetiyor — onu yakında "
"göreceksin!"

#. [message]: role=speaker {FILTER_LOCATION x,y,radius=44,7,4}
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:524
msgid ""
"Not many. Ethiliel is managing the rest of the retreat — you will see her "
"soon!"
msgstr ""
"Çok değil. Ethiliel geri çekilmenin geri kalanını yönetiyor — onu yakında "
"göreceksin!"

#. [message]: role=speaker {FILTER_LOCATION x,y,radius=44,7,4}
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:530
msgid ""
"Not many. Tanyth is managing the rest of the retreat — you will see her "
"soon!"
msgstr ""
"Çok değil. Tanyth geri çekilmenin geri kalanını yönetiyor — onu yakında "
"göreceksin!"

#. [message]: id=$elf_leader.id
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:559
msgid ""
"Konrad, I lead the last of the evacuees — we shall make for the ford at "
"once. But be wary, for the human general comes nipping at our heels!"
msgstr ""
"Konrad, tahliye edilenlerin sonuncusuna ben liderlik ediyorum — hemen geçide"
" doğru ilerleyeceğiz. Ama dikkatli ol, çünkü insan general topuklarımıza "
"basıyor!"

#. [message]: id=$elf_leader.id
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:560
msgid ""
"female^Konrad, I lead the last of the evacuees — we shall make for the ford "
"at once. But be wary, for the human general comes nipping at our heels!"
msgstr ""
"female^Konrad, tahliye edilenlerin sonuncusuna ben liderlik ediyorum — hemen"
" geçide doğru ilerleyeceğiz. Ama dikkatli ol, çünkü insan general "
"topuklarımıza basıyor!"

#. [message]: speaker=Isolde
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:572
msgid ""
"Keep pushing forward — don’t let any more of them escape. Twenty gold pieces"
" for whoever takes the head of their leader!"
msgstr ""
"İleri doğru bastırmaya devam edin — daha fazla kaçmalarına izin vermeyin. "
"Liderlerinin kafasını getirene yirmi altın!"

#. [message]: speaker=Isolde
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:576
msgid ""
"... is that Konrad? The pretender prince!? He’s returned! We have an "
"opportunity to make up for our previous failure — men, seize him at once!"
msgstr ""
"... o Konrad mı? Sahte prens mi!? Geri döndü! Önceki başarısızlığımızı "
"telafi etmek için bir fırsatımız var — adamlar, onu hemen yakalayın!"

#. [message]: speaker=Konrad {KONRAD_VARIATION mad}
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:643
msgid "You should never have attacked my home, you villain!"
msgstr "Evime asla saldırmamalıydın, seni alçak!"

#. [message]: speaker=Konrad {KONRAD_VARIATION glad}
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:651
msgid ""
"That’s the last of their leaders defeated! With Wesnoth beaten back, even if"
" only temporarily, the rest of the elves can safely evacuate."
msgstr ""
"Liderlerinin sonuncusu da yenildi! Wesnoth geri püskürtüldüğüne göre, geçici"
" de olsa, elflerin geri kalanı güvenle tahliye edilebilir."

#. [message]: role=victory_speaker
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:677
msgid ""
"Scatter to the south; scatter to the west! Spread ourselves in hiding across"
" the entire wood, and they shall never be able to root us out."
msgstr ""
"Güneye dağılın; batıya dağılın! Tüm ormana saklanarak yayılın, böylece bizi "
"asla kökümüzden sökemezler."

#. [message]: role=victory_speaker
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:705
msgid ""
"You have my gratitude, friend Konrad. Without your help, this would surely "
"have been a great slaughter. Allow us to aid you in return."
msgstr ""
"Minnettarım sana, dostum Konrad. Senin yardımın olmasaydı, bu kesinlikle "
"büyük bir katliam olurdu. Karşılığında sana yardım etmemize izin ver."

#. [message]: role=victory_speaker
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:710
msgid ""
"With so many of our number safely escaped, our archers, fighter, and scouts "
"all stand ready to join you on your journey!"
msgstr ""
"Sayımızın çoğu güvenle kaçtığı için, okçularımız, savaşçılarımız ve "
"izcilerimiz yolculuğunda sana katılmaya hazırlar!"

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:712
msgid "Konrad can now recruit Elvish Archers, Fighters, and Scouts!"
msgstr "Konrad artık Elf Okçuları, Savaşçıları ve İzcileri toplayabilir!"

#. [message]: role=victory_speaker
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:717
msgid ""
"Though some of our number have fallen, many have escaped to safety! Our "
"archers and scouts both stand ready to join you on your journey."
msgstr ""
"Sayımızın bazıları düşmüş olsa da, çoğu güvenliğe kaçtı! Okçularımız ve "
"izcilerimiz yolculuğunda sana katılmaya hazırlar."

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:719
msgid "Konrad can now recruit Elvish Archers and Scouts!"
msgstr "Konrad artık Elf Okçuları ve İzcileri toplayabilir!"

#. [message]: role=victory_speaker
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:724
msgid ""
"Though many of our number have fallen, at least some have escaped. Our "
"archers stand ready to join you on your journey."
msgstr ""
"Sayımızın çoğu düşmüş olsa da, en azından bazıları kaçtı. Okçularımız "
"yolculuğunda sana katılmaya hazırlar."

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:726
msgid "Konrad can now recruit Elvish Archers!"
msgstr "Konrad artık Elf Okçuları toplayabilir!"

#. [message]: role=victory_speaker
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:731
msgid ""
"Yet even with your aid, only a scant few of us elves have escaped. I fear "
"that none of our number can be spared to join you on your journey."
msgstr ""
"Yine de senin yardımınla bile, biz elflerden sadece çok azı kaçabildi. "
"Korkarım ki sayımızdan hiçbiri yolculuğunda sana katılmak için ayrılamaz."

#. [companion_message]
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:740
msgid ""
"Now, young prince, it is time for us to make our escape as well. Be swift — "
"make for the western forest!"
msgstr ""
"Şimdi, genç prens, bizim de kaçma zamanımız geldi. Hızlı ol — batı ormanına "
"doğru ilerle!"

#. [companion_message]
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:741
msgid ""
"Now it’s time for us to make our escape too. Quick, make for the western "
"forest!"
msgstr ""
"Şimdi bizim de kaçma zamanımız geldi. Çabuk, batı ormanına doğru ilerle!"

#. [scenario]
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:15
msgid "scenario name^Blackwater Port"
msgstr "scenario name^Karasu Limanı"

#. [side]: type=Orcish Warrior, id=Mokolo Qimur
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:82
msgid "Mokolo Qimur"
msgstr "Mokolo Qimur"

#. [side]: type=Orcish Warrior, id=Mokolo Qimur
#. [side]: type={TYPE}, id={ID}
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:88
#: data/campaigns/Heir_To_The_Throne/scenarios/10_Elensefar_Before.cfg:77
#: data/campaigns/Heir_To_The_Throne/scenarios/11_Elensefar_After.cfg:48
msgid "Clan Foxtail"
msgstr "Tilki Kuyruğu Klanı"

#. [side]
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:163
msgid "Rebels"
msgstr "İsyancılar"

#. [message]: speaker=Konrad {KONRAD_VARIATION concerned}
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:262
msgid "Uncle Kaylan, we’re here! Are you alright? What can I do to help?"
msgstr "Kaylan Amca, buradayız! İyi misin? Yardım etmek için ne yapabilirim?"

#. [message]: speaker=Kaylan
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:267
msgid ""
"Welcome Delfador, welcome Konrad! It is an honor to once again lay eyes upon"
" the true heir of Wesnoth. The false queen’s forces have caught us "
"unprepared, but the bulk of my riders shall soon return to rout the enemy "
"and seize our victory!"
msgstr ""
"Hoş geldin Delfador, hoş geldin Konrad! Wesnoth'un gerçek varisini bir kez "
"daha görmek bir onurdur. Sahte kraliçenin güçleri bizi hazırlıksız yakaladı,"
" ancak süvarilerimin çoğu düşmanı bozguna uğratmak ve zaferimizi ele "
"geçirmek için yakında geri dönecek!"

#. [message]: speaker=Delfador
#. after the player completes this scenario, Delfador leaves. Foreshadow that
#. now.
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:272
msgid ""
"How soon, Kaylan? I suspect Elensefar to be under siege as well — I cannot "
"leave Maddock to fight alone, yet neither can I leave the prince unguarded."
msgstr ""
"Ne kadar çabuk, Kaylan? Elensefar'ın da kuşatma altında olduğundan "
"şüpheleniyorum — Maddock'u tek başına savaşmaya bırakamam, prensi de "
"korumasız bırakamam."

#. [message]: speaker=Kaylan
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:277
msgid ""
"Welcome, young Konrad! It is an honor to once again lay eyes upon the true "
"heir of Wesnoth. The false queen’s forces have caught us unprepared, but the"
" bulk of my riders shall soon return to rout the enemy and seize our "
"victory!"
msgstr ""
"Hoş geldin, genç Konrad! Wesnoth'un gerçek varisini bir kez daha görmek bir "
"onurdur. Sahte kraliçenin güçleri bizi hazırlıksız yakaladı, ancak "
"süvarilerimin çoğu düşmanı bozguna uğratmak ve zaferimizi ele geçirmek için "
"yakında geri dönecek!"

#. [message]: speaker=Konrad
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:281
msgid ""
"I’m glad to be here, but sorry we couldn’t come sooner. For how long must we"
" defend before your reinforcements arrive?"
msgstr ""
"Burada olmaktan memnunum ama daha erken gelemediğimiz için üzgünüm. "
"Takviyeleriniz gelene kadar ne kadar süre savunmalıyız?"

#. [message]: speaker=Kaylan
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:286
msgid ""
"If we can hold Blackwater for just a few more days, victory shall be "
"assured! I am encircled and trapped in the port, but with your help the "
"siege can be broken. Hearken to my words, Konrad, and Blackwater Port shall "
"yet endure!"
msgstr ""
"Blackwater'ı birkaç gün daha tutabilirsek, zafer garanti olacak! Limanda "
"kuşatılmış ve kapana kısılmış durumdayım, ancak sizin yardımınızla kuşatma "
"kırılabilir. Sözlerime kulak ver, Konrad, ve Blackwater Limanı yine de "
"dayanacak!"

#. [objective]: condition=win
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:295
#: data/campaigns/Heir_To_The_Throne/scenarios/07_Muff_Malals_Peninsula.cfg:290
#: data/campaigns/Heir_To_The_Throne/scenarios/10_Elensefar_Before.cfg:571
#: data/campaigns/Heir_To_The_Throne/scenarios/15b_Valley_of_Death_part2.cfg:350
#: data/campaigns/Heir_To_The_Throne/scenarios/48_Dan_Tonk.cfg:316
msgid "Survive until turns run out"
msgstr "Süre bitene kadar hayatta kal"

#. [objective]: condition=win
#. [objective]: description=<span strikethrough='true' color='#A9A9A9'>,
#. condition=win
#. if Kaylan is protected, Konrad will learn to recruit Cavalrymen and
#. Horsemen
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:302
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:310
msgid "Protect Sir Kaylan: recruit Cavalrymen and Horsemen"
msgstr "Sör Kaylan'ı koru: Süvari ve Atlı asker topla"

#. [objective]: condition=win
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:323
#: data/campaigns/Heir_To_The_Throne/scenarios/06_The_Isle_of_Alduin.cfg:305
#: data/campaigns/Heir_To_The_Throne/scenarios/08a_Isle_of_the_Damned_part1.cfg:285
#: data/campaigns/Heir_To_The_Throne/scenarios/11_Elensefar_After.cfg:334
#: data/campaigns/Heir_To_The_Throne/scenarios/15a_Valley_of_Death_part1.cfg:303
#: data/campaigns/Heir_To_The_Throne/scenarios/28_The_Lost_General.cfg:244
msgid "Defeat all enemy leaders"
msgstr "Tüm düşman liderlerini yen"

#. [objective]: condition=win
#. This is an objective note. Completing this objective will be very hard, but
#. you gain an early finish bonus and a loyal unit.
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:325
msgid "(very hard: early finish bonus &#38; loyal companion)"
msgstr "(çok zor: erken bitirme bonusu &#38; sadık yoldaş)"

#. [message]: speaker=Kaylan
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:345
msgid ""
"Brothers-in-arms, fighting side-by-side! Not since the death of the old king"
" have I felt this way, young Konrad. If I have but one regret in my life, it"
" is that I could not raise you here as my own."
msgstr ""
"Silah arkadaşları, omuz omuza savaşıyoruz! Yaşlı kralın ölümünden beri böyle"
" hissetmemiştim, genç Konrad. Hayatımda tek bir pişmanlığım varsa, o da seni"
" burada kendi evladım gibi büyütememiş olmamdır."

#. [message]: speaker=Konrad
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:349
msgid ""
"Master Delfador told me: You wanted to raise me in Blackwater Port among "
"other humans, but he felt it was too dangerous."
msgstr ""
"Usta Delfador bana söyledi: Beni Blackwater Limanı'nda diğer insanlar "
"arasında büyütmek istemişsin, ama o bunun çok tehlikeli olduğunu düşünmüş."

#. [message]: speaker=Konrad
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:353
msgid ""
"I don’t mind though. I like elves, and we still got to come visit you "
"sometimes."
msgstr ""
"Yine de umursamıyorum. Elfleri severim ve yine de bazen seni ziyarete "
"gelebildik."

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:357
msgid ""
"And I was quite right, too. A military town is no place for a young child; "
"Blackwater Port has seen its fair share of battles since I first rescued "
"you, Konrad."
msgstr ""
"Ve ben de haklıydım. Askeri bir kasaba küçük bir çocuk için uygun bir yer "
"değildir; Blackwater Limanı, seni ilk kurtardığımdan beri birçok savaşa "
"tanık oldu, Konrad."

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:368
msgid "Vygwyn"
msgstr "Vygwyn"

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:369
msgid "Gaebryn"
msgstr "Gaebryn"

#. [message]: speaker=Vygwyn
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:373
msgid ""
"Hail, Sir Kaylan! We rode as swiftly as we could, and come to aid in the "
"defense! The others will arrive soon — do not despair!"
msgstr ""
"Selam, Sör Kaylan! Olabildiğince hızlı sürdük ve savunmaya yardıma geldik! "
"Diğerleri de yakında gelecek — umutsuzluğa kapılma!"

#. [message]: speaker=Vygwyn
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:378
msgid ""
"Hail, is anyone still alive? We rode as swiftly as we could, and come to aid"
" in the defense. Do not despair — the rest of your reinforcements will soon "
"arrive!"
msgstr ""
"Selam, hala hayatta olan var mı? Olabildiğince hızlı sürdük ve savunmaya "
"yardıma geldik. Umutsuzluğa kapılma — takviyelerinin geri kalanı yakında "
"gelecek!"

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:425
msgid "Yredd"
msgstr "Yredd"

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:426
msgid "Tarcyn"
msgstr "Tarcyn"

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:427
msgid "Syryn"
msgstr "Syryn"

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:428
msgid "Cicyn"
msgstr "Cicyn"

#. [event]
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:429
msgid "Ginvan"
msgstr "Ginvan"

#. [unit]: id=Haldiel, type=Horseman
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:433
msgid "Haldiel"
msgstr "Haldiel"

#. [unit]: type=Knight, id=Simyr
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:448
msgid "Simyr"
msgstr "Simyr"

#. [message]: speaker=Simyr
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:475
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:516
msgid ""
"Your promised reinforcements have arrived! Time to drive back the false "
"queen’s troops from the port!"
msgstr ""
"Vaat edilen takviyeleriniz geldi! Sahte kraliçenin birliklerini limandan "
"geri püskürtme zamanı!"

#. [message]: speaker=Kaylan
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:480
msgid ""
"Our promised reinforcements have arrived! Time to drive back the false "
"queen’s troops from the port!"
msgstr ""
"Vaat edilen takviyelerimiz geldi! Sahte kraliçenin birliklerini limandan "
"geri püskürtme zamanı!"

#. [message]: speaker=Mokolo Qimur
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:485
msgid ""
"So many foul humans riding on horses! Asheviere isn’t paying me nearly "
"enough for this. Let’s get out of here!"
msgstr ""
"At sırtında ne kadar da çok iğrenç insan var! Aşivye bunun için bana "
"yeterince ödeme yapmıyor. Hadi buradan gidelim!"

#. [message]: speaker=enemy1
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:490
msgid "The enemy has been reinforced! Quick, we must make our escape!"
msgstr "Düşman takviye aldı! Çabuk, kaçmalıyız!"

#. [message]: speaker=enemy2
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:495
msgid "Retreat! Fall back!"
msgstr "Geri çekilin! Geriye!"

#. [message]: speaker=Kaylan
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:521
msgid ""
"Reinforcements have arrived, but lo! Together we have already managed to "
"repel the false queen’s attack!"
msgstr ""
"Takviyeler geldi, ama bakın! Birlikte sahte kraliçenin saldırısını zaten "
"püskürtmeyi başardık!"

#. [message]: speaker=Simyr
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:548
msgid ""
"Victory is ours — but at such cost! Where is the lord of the town? What has "
"become of Sir Kaylan?"
msgstr ""
"Zafer bizim — ama ne pahasına! Kasabanın lordu nerede? Sör Kaylan'a ne oldu?"

#. [message]: speaker=Konrad {KONRAD_VARIATION concerned}
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:552
msgid ""
"Uncle Kaylan— <b>Sir</b> Kaylan fought bravely... but in the end he fell, "
"pierced by Asheviere’s spears. It is thanks to his sacrifice that Blackwater"
" Port still stands free."
msgstr ""
"Kaylan Amca— <b>Sör</b> Kaylan cesurca savaştı... ama sonunda Aşivye'in "
"mızraklarıyla delinerek düştü. Blackwater Limanı'nın hala özgür kalması onun"
" fedakarlığı sayesindedir."

#. [message]: speaker=Simyr
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:559
msgid ""
"Alas, this is ill news indeed. A hero’s death, but a death nonetheless. "
"Kaylan had hoped to send some of our number with you on your journey, but "
"with his passing we cannot afford to send the Horsemen and Cavalrymen he had"
" hoped to."
msgstr ""
"Ne yazık ki, bu gerçekten kötü bir haber. Bir kahramanın ölümü, ama yine de "
"bir ölüm. Kaylan, yolculuğunuzda bazı adamlarımızı sizinle göndermeyi "
"ummuştu, ancak onun vefatıyla umduğu Atlı ve Süvari askerleri gönderemeyiz."

#. [message]: speaker=Haldiel
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:563
msgid ""
"Yet with Asheviere’s armies defeated today, surely we can spare at least a "
"few of our number? Though it is true that the bulk of our forces must remain"
" behind to guard the port, we can still partially fufill Sir Kaylan’s last "
"wish, Sir Simyr."
msgstr ""
"Ancak Aşivye'in orduları bugün yenilmişken, kesinlikle birkaç adamımızı "
"ayırabiliriz, değil mi? Güçlerimizin çoğunun limanı korumak için geride "
"kalması gerektiği doğru olsa da, Sör Kaylan'ın son arzusunu kısmen yerine "
"getirebiliriz, Sör Simyr."

#. [message]: speaker=Simyr
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:567
msgid ""
"Very well. Haldiel and I shall join you on your quest, Your Royal Highness."
msgstr "Pekala. Haldiel ve ben görevinizde size katılacağız, Majesteleri."

#. [message]: speaker=Simyr
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:577
msgid ""
"Alas, this is ill news indeed. A hero’s death, but a death nonetheless. "
"Kaylan had hoped to send some of our number with you on your journey, but "
"with his passing we can no longer afford to. Konrad, you will have to "
"journey on from here with only Peasants and Woodsmen by your side."
msgstr ""
"Ne yazık ki, bu gerçekten kötü bir haber. Bir kahramanın ölümü, ama yine de "
"bir ölüm. Kaylan, yolculuğunuzda bazı adamlarımızı sizinle göndermeyi "
"ummuştu, ancak onun vefatıyla artık bunu karşılayamayız. Konrad, buradan "
"itibaren sadece Köylüler ve Oduncularla yolculuğuna devam etmek zorunda "
"kalacaksın."

#. [message]: speaker=Kaylan
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:585
msgid ""
"A glorious victory — thank you for your help, compatriots! I must remain "
"here to safeguard the port, but with the false queen’s troops repelled many "
"of my riders are free to accompany you on your quest. Konrad, may they serve"
" you well!"
msgstr ""
"Muhteşem bir zafer — yardımınız için teşekkürler, yoldaşlar! Limanı korumak "
"için burada kalmalıyım, ancak sahte kraliçenin birlikleri püskürtüldüğü için"
" süvarilerimin çoğu görevinizde size eşlik etmekte özgür. Konrad, umarım "
"size iyi hizmet ederler!"

#. [else]
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:587
msgid "Konrad can now recruit Cavalrymen and Horsemen!"
msgstr "Konrad artık Süvari ve Atlı asker toplayabilir!"

#. [message]: speaker=Kaylan
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:596
msgid ""
"... and with the invading force so thoroughly defeated, I can afford to give"
" you more riders than I had originally planned. Haldiel, Simyr, step "
"forward! I place your lances in the service of His Highness here. May you "
"help him restore order to the country."
msgstr ""
"... ve işgalci kuvvet bu kadar kapsamlı bir şekilde yenilmişken, size "
"başlangıçta planladığımdan daha fazla süvari verebilirim. Haldiel, Simyr, "
"öne çıkın! Mızraklarınızı Majestelerinin hizmetine sunuyorum. Umarım ülkeye "
"düzeni geri getirmesine yardımcı olursunuz."

#. [message]: speaker=Kaylan
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:601
msgid ""
"... and with the invading force so thoroughly defeated, I can afford to give"
" you more riders than I had originally planned. Haldiel, step forward! I "
"place your lance in the service of His Highness here. May you help him "
"restore order to the country."
msgstr ""
"... ve işgalci kuvvet bu kadar kapsamlı bir şekilde yenilmişken, size "
"başlangıçta planladığımdan daha fazla süvari verebilirim. Haldiel, öne çık! "
"Mızrağını Majestelerinin hizmetine sunuyorum. Umarım ülkeye düzeni geri "
"getirmesine yardımcı olursun."

#. [message]: speaker=Haldiel
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:614
msgid "Greetings, young master. I pledge myself to your service."
msgstr "Selamlar, genç efendi. Kendimi hizmetinize adıyorum."

#. [message]: speaker=Simyr
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:619
msgid "It is my pleasure and honor to serve, my liege."
msgstr "Hizmet etmek benim için bir zevk ve onurdur, efendim."

#. [message]: speaker=unit
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:638
msgid "I have failed in my duty to protect the rightful heir and the port..."
msgstr "Meşru varisi ve limanı koruma görevimde başarısız oldum..."

#. [message]: speaker=Konrad {KONRAD_VARIATION concerned}
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:645
msgid ""
"Kaylan, no! Please, you have to get back up! You have to keep fighting!"
msgstr "Kaylan, hayır! Lütfen, ayağa kalkmalısın! Savaşmaya devam etmelisin!"

#. [message]: speaker=Delfador
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:652
msgid ""
"I’m sorry, Konrad. He is lost to us now... Today we mourn a good man..."
msgstr ""
"Üzgünüm, Konrad. Onu artık kaybettik... Bugün iyi bir adam için yas "
"tutuyoruz..."

#. [message]: speaker=Konrad {KONRAD_VARIATION concerned}
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:659
msgid "He’s gone, isn’t he... Today we mourn a good man."
msgstr "Gitti, değil mi... Bugün iyi bir adam için yas tutuyoruz."

#. [message]: speaker=1Mer1
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:133
msgid ""
"Are you coming to liberate us? Finally, we stand a chance against the orcs!"
msgstr ""
"Bizi kurtarmaya mı geliyorsunuz? Sonunda orklara karşı bir şansımız var!"

#. [message]: speaker=4Mer1
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:140
msgid "Now that we are free, together we can defeat our oppressors!"
msgstr "Artık özgür olduğumuza göre, birlikte zalimlerimizi yenebiliriz!"

#. [message]: speaker=5Mer1
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:147
msgid "Let’s take back the Trident the orcs stole from us!"
msgstr "Orkların bizden çaldığı Üç Dişli Mızrağı geri alalım!"

#. [message]: speaker=6Mer1
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:154
msgid ""
"Death to the orcs! Come, my brethren, let us fight the orcs and drive them "
"from our shores!"
msgstr ""
"Orklara ölüm! Gelin kardeşlerim, orklarla savaşalım ve onları kıyılarımızdan"
" sürelim!"

#. [message]: speaker=8Mer1
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:161
msgid "Thank you for rescuing us! Now we can help you fight the evil orcs!"
msgstr ""
"Bizi kurtardığınız için teşekkür ederiz! Şimdi size kötü orklarla "
"savaşmanızda yardım edebiliriz!"

#. [message]: speaker=9Mer1
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:168
msgid "Freedom! Now where are those orcs? Let me at ’em!"
msgstr ""
"Özgürlük! Şimdi o orklar nerede? Bırakın da onlara bir haddini bildireyim!"

#. [scenario]
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:273
